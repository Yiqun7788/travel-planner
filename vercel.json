{
  "buildCommand": "",
  "outputDirectory": "",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/create-checkout-session", "destination": "/api/create-checkout-session" },
    { "source": "/api/verify-payment", "destination": "/api/verify-payment" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
